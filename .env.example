# .env.local — cropitGIF Companion Website
# Copy this file to .env.local and fill in your real values.

# ── Admin Auth ───────────────────────────────────────────────────
# Signing secret for HTTP-only session tokens (any 32+ char random string)
ADMIN_SECRET=replace-this-with-a-random-32-plus-char-string

# Dev-only fallback credentials (used when Supabase is not configured)
# DEV_ADMIN_EMAIL=thacoj@gmail.com    # default: thacoj@gmail.com
# DEV_ADMIN_PASSWORD=dev              # default: dev

# ── Email ────────────────────────────────────────────────────────
# Option A: Resend (recommended — free tier at resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=cropitGIF <no-reply@yourdomain.com>

# Option B: Gmail SMTP (App Password)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM_NAME=cropitGIF

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OTP Security ─────────────────────────────────────────────────
# OTP_SECRET=replace-this-with-a-random-32-plus-char-string
